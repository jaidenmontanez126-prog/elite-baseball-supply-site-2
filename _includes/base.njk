<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}{% if title != "Elite Baseball Supply" %} | Elite Baseball Supply{% endif %}</title>
<meta name="description" content="{{ description or excerpt or 'Baseball equipment comparisons, practical buying guides, and fan gear picks. Find the right fit for your game.' }}">
<link rel="canonical" href="https://elitebaseballsupply.com{{ page.url }}">
<meta property="og:title" content="{{ title }}"><meta property="og:description" content="{{ description or excerpt or 'Find the right gear for your game.' }}"><meta property="og:type" content="{{ 'article' if layout == 'post.njk' else 'website' }}"><meta property="og:url" content="https://elitebaseballsupply.com{{ page.url }}"><meta property="og:image" content="{{ (image or '/logo.png') | absoluteUrl }}">
<script>
(() => {
  const key = 'ebs-reading-theme';
  const deviceTheme = window.matchMedia('(prefers-color-scheme: dark)');
  const root = document.documentElement;
  let preference = 'system';

  try {
    const saved = localStorage.getItem(key);
    if (saved === 'light' || saved === 'dark') preference = saved;
  } catch {
    // The theme still works on the current page.
  }

  function applyTheme() {
    root.dataset.siteTheme = preference === 'system'
      ? (deviceTheme.matches ? 'dark' : 'light')
      : preference;
  }

  applyTheme();
  deviceTheme.addEventListener('change', applyTheme);
  document.addEventListener('DOMContentLoaded', () => {
    const control = document.querySelector('#site-theme');
    control.value = preference;
    control.parentElement.hidden = false;
    control.addEventListener('change', () => {
      preference = control.value;
      applyTheme();
      try {
        localStorage.setItem(key, preference);
      } catch {
        // The selected theme remains active on the current page.
      }
    });
  });
})();
</script>
