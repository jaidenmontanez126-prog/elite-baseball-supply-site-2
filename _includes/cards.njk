{% for post in posts %}<article class="story-card" data-category="{{ post.data.category }}"><a class="story-image{% if not post.data.image %} image-placeholder{% endif %}" href="{{ post.url }}" tabindex="-1" aria-hidden="true">{% if post.data.image %}<img src="{{ post.data.image }}" alt="" loading="lazy" width="600" height="450">{% else %}<span class="placeholder-mark" aria-hidden="true">E<span>/</span>B</span><span>{{ post.data.category }} / FIELD NOTES</span>{% endif %}</a><div class="story-copy"><p class="eyebrow">{{ post.data.category }} <span> / {{ post.date | dateDisplay }}</span></p><h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3><p>{{ post.data.excerpt }}</p><a class="text-link" href="{{ post.url }}">Read the guide <span aria-hidden="true">↗</span></a></div></article>{% endfor %}