

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }} | Elite Baseball Supply</title>

    <link rel="stylesheet" href="/style.css">
</head>
<body>

<header class="site-header">
    <div class="container header-inner">
        <a href="/" class="logo">
            <img src="/logo.png" alt="Elite Baseball Supply">
        </a>

        <nav class="main-nav">
            <a href="/">Home</a>
            <a href="/pages/reviews/">Reviews</a>
            <a href="/pages/privacy-policy/">Privacy Policy</a>
            <a href="/pages/affiliate-disclosure/">Affiliate Disclosure</a>
            <a href="/pages/about/">About</a>
            <a href="/pages/contact/">Contact</a>
        </nav>
    </div>
</header>

<main class="container">
<article class="blog-post post-card">
        <h1>{{ title }}</h1>
    
<p class="post-meta">            
<strong>Category:</strong> {{ category }}<br>
            <strong>Author:</strong> {{ author }}<br>
<strong>Published:</strong> {{ date }}        
</p>
    
        {% if image %}
<img class="post-featured-image" src="{{ image }}" alt="{{ title }}">        
{% endif %}
    
        {{ content | safe }}    
    </article>
</main>

</body>
</html>